  {
  "name": "fnlink",
  "version": "1.1.7",
  "private": true,
  "description": "PC-клиент микро-мессенджера",
  "author": "TechMagicInfinity <my-email@email.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechMagicInfinity/FNLink.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    ...
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "executableArgs": ["--no-sandbox"]
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TechMagicInfinity",
      "repo": "FNLink",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network"
    }
  }
}
