{
  "name": "micromessenger-client",
  "version": "1.0.0",
  "private": true,
  "description": "PC-клиент микро-мессенджера",
  "author": "TechMagicInfinity",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechMagicInfinity/DMmessenger.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.techmagicinfinity.micromessenger",
    "productName": "Micromessenger",
    "files": [
      "**/*",
      "!**/node_modules/electron-builder${/*}"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "TechMagicInfinity",
      "repo": "DMmessenger"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    }
  }
}
